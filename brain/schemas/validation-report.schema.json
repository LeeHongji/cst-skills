{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cst-automation.local/schemas/validation-report.schema.json",
  "title": "CST Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_type", "subject_id", "status", "checks", "validated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "subject_type": {"enum": ["project", "revision", "experiment", "trial", "run"]},
    "subject_id": {"type": "string"},
    "status": {"enum": ["valid", "invalid", "partial", "blocked"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "fail", "warning", "not_applicable"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string"}
        }
      }
    },
    "validated_at": {"type": "string", "format": "date-time"}
  },
  "x-superseded-by": "iteration.schema.json",
  "x-supersession-note": "Superseded by the four contracts of the topic-driven architecture. Still present because its writer is still live; the file is removed together with the code that produces it, not before, so the running plane does not break in between."
}
